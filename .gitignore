# pyenv
#   For a library or package, you might want to ignore these files since the code is
#   intended to run in multiple environments; otherwise, check them in:
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, if you're executing pipelines or debugging and want to ignore it, uncomment the following:
# Pipfile.lock

# poetry
#   Similar to Pipenv, poetry.lock is generally recommended to be tracked in version control.
#   However, if you want to ignore it, uncomment the following:
# poetry.lock

# pdm
#   Similar to Pipenv and Poetry, pdm.lock is generally recommended to be tracked in version control.
#   pdm.lock
#   pdm build directory
.pdm-build/

# PEP 582; used by e.g. github.com/lincolnloop/layman and pdm
__pypackages__/

